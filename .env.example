# Copy this file to .env and restrict it with: chmod 600 ~/runtasks/.env
# RunTasks loads values here separately from non-secret TOML configuration.
# Process environment variables named RUNTASKS_* override matching file values.
# Never commit real credentials, identifiers, or tokens.

# Telegram token received from the official @BotFather account.
RUNTASKS_TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to operate the bot.
RUNTASKS_TELEGRAM_ALLOWED_USER_IDS=

# Numeric destination chat ID. A positive private-DM ID is recommended.
RUNTASKS_TELEGRAM_NOTIFICATION_CHAT_ID=

# Optional positive forum topic/thread ID for a verified supergroup.
RUNTASKS_TELEGRAM_THREAD_ID=
